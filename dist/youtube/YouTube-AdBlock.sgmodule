#!name=YouTube 全平台去广告 v1.2.11
#!desc=Mac 与移动浏览器网页去广告；原生设备请使用 iOS/tvOS 模块。启用前必须关闭全局 hostname=* HTTPS 捕获；脚本只进入有效配置，不会复制到主配置。
#!category=广告过滤
#!arguments=debug:false,update_interval:21600
#!arguments-desc=debug：两条网页脚本调试日志，true/false；update_interval：远程脚本更新间隔，单位秒

# ============================================================
# [安装与证书信任设置]
# 1. 从 URL 安装本模块；安装完成不等于启用，必须在每台设备的模块列表打开开关。
# 2. 启用前检查 Surge 的有效 [MITM]，不要保留单独的 hostname = * 或“捕获全部 HTTPS”；
#    这会让 Bilibili、银行等证书固定应用主动断开。模块使用 %APPEND% 只追加 YouTube 主机，
#    不能替已有的全局通配符。
# 3. iPhone/iPad：在 Surge 的 MITM 页面生成并安装 CA；然后进入
#    设置 > 通用 > VPN 与设备管理完成描述文件安装，再进入
#    设置 > 通用 > 关于本机 > 证书信任设置，为 Surge 根证书开启完全信任。
# 4. macOS：在 Surge MITM 页面把 CA 安装到系统钥匙串；如仍显示不受信任，
#    在“钥匙串访问 > 显示简介 > 信任”中把 SSL 设为始终信任。
# 5. 证书只需首次安装；模块不能携带、安装或信任 CA 和私钥。
# 6. 安装或更新后应强制退出浏览器，再重新建立 TLS 连接。
#
# [更新方法]
# - 在 Surge 已安装模块列表点击刷新，或再次打开同一个一键安装链接并选择替换。
# - update_interval 默认 21600 秒；脚本使用 releases/<版本>/ 目录和 ?v= 参数固定版本。
# - 不要保留两个同名模块，也不要同时启用其他重复处理 YouTube 的模块。
#
# [无法播放 / 证书错误]
# - 先停用本模块确认是否恢复，再检查证书是否“完全信任”。
# - 停用旧模块中的 *.googlevideo.com MITM、initplayback 请求改写和重复 youtubei 脚本。
# - 当前模块故意不解密 *.googlevideo.com，以降低黑屏、转圈和连接不安全风险。
#
# [回滚方法]
# - 在模块列表停用或删除“ YouTube 全平台去广告 v1.2.11”，重新加载配置并重启 YouTube。
# - 本模块不直接改写主配置，因此正常情况下无需手工删除 [MITM] 或 [Script] 行。
# - 完整说明：https://github.com/cndxf/lab/tree/main/YouTube-%E5%85%A8%E5%B9%B3%E5%8F%B0%E5%8E%BB%E5%B9%BF%E5%91%8A/clients/surge

# ============================================================
# [COMMON / 多客户端通用]
# 强制 youtubei API 从 QUIC 回落到可进行脚本处理的 TCP/TLS。
# 不拦截 *.googlevideo.com，避免旧方案造成网页视频无法播放。
# ============================================================
[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT

# ============================================================
# [WEB / 网页专用]
# response 在 JSON 渲染前清理广告结构；page 注入 DOM/播放器恢复逻辑。
# 覆盖桌面网页和 m.youtube.com，不用于原生 App protobuf。
# ============================================================
[Script]
youtube.web.response = type=http-response,pattern=^https:\/\/(?:www|m)\.youtube\.com\/youtubei\/v1\/(?:next|browse|search|get_watch|reel\/reel_watch_sequence|player|player\/ad_break)(?:\?.*)?$,requires-body=1,max-size=10485760,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.11/scripts/youtube-web-response.js?v=1.2.11,script-update-interval={{{update_interval}}}
youtube.web.page = type=http-response,pattern=^https:\/\/(?:www|m)\.youtube\.com\/(?:(?:watch|results|playlist)(?:\?.*)?|shorts\/(?:[^/?#]+)?(?:\?.*)?|(?:live|post|hashtag|clip|embed)\/[^/?#]+(?:\?.*)?|feed\/[^?#]+(?:\?.*)?|(?:@[^/?#]+|(?:channel|c|user)\/[^/?#]+)(?:\/[^?#]*)?(?:\?.*)?|(?:\?.*)?)$,requires-body=1,max-size=10485760,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.11/scripts/youtube-web-page.js?v=1.2.11,script-update-interval={{{update_interval}}}

# ============================================================
# [MITM]
# 模块只能声明域名，不能安装、分发或信任证书和私钥。
# ============================================================
[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, youtubei.googleapis.com
