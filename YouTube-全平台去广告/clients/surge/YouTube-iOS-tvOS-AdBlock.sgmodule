#!name=YouTube iOS/tvOS 去广告
#!desc=iPhone、iPad 与 Apple TV 原生 YouTube 去广告；本地处理加密播放流，Apple TV 仍为实验支持。
#!category=广告过滤
#!requirement=CORE_VERSION >= 20 && (SYSTEM = 'iOS' || SYSTEM = 'tvOS')
#!arguments=caption_lang:off,block_upload:false,block_immersive:false,block_shorts:false,debug:false,update_interval:21600
#!arguments-desc=caption_lang：原生 App 字幕翻译语言，off 为关闭；block_upload：隐藏上传按钮，true/false；block_immersive：隐藏选段按钮，true/false；block_shorts：隐藏 Shorts，true/false；debug：调试日志，true/false；update_interval：远程脚本更新间隔，单位秒

# ============================================================
# [安装与证书信任设置]
# 1. 该模块仅允许在 iOS/iPadOS/tvOS 使用；macOS 继续使用不解密
#    googlevideo 的“YouTube 全平台去广告”基础模块。
# 2. iPhone/iPad 安装后，必须在 Surge 中安装并完全信任 MITM CA。
# 3. Apple TV 需先由 Surge iOS 部署配置与证书，然后重启 Surge tvOS 和 YouTube。
# 4. 本模块会解密 *.googlevideo.com 的 initplayback 请求；处理全部在本机完成，
#    不使用 init-stream.maasea.workers.dev 或其他第三方 Worker。
# 5. 安装或更新后强制退出 YouTube，再重新打开建立 TLS 连接。
#
# [更新方法]
# - 在 Surge 已安装模块列表点击刷新，或重新打开 iOS/tvOS 一键安装入口并选择替换。
# - update_interval 默认 21600 秒；脚本使用 releases/<版本>/ 目录和 ?v= 参数固定版本。
#
# [无法播放 / 回滚方法]
# - 先停用本模块并重启 YouTube；停用后恢复即说明问题在 initplayback 路径。
# - 不要同时启用其他含 *.googlevideo.com MITM 或 initplayback 改写的 YouTube 模块。
# - 本模块不直接改写主配置；停用或删除后重新加载即可回滚。

# ============================================================
# [COMMON / 多客户端通用]
# youtubei API 快速拒绝 QUIC，使 protobuf 响应回落到可脚本处理的 TCP/TLS。
# ============================================================
[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT

# ============================================================
# [MOBILE / 移动端专用]
# response 清理普通 youtubei protobuf；request.init 校验 onesie key；
# response.init 在本机解密、清理并重新加密 UMP 播放流。
#
# [TVOS / Apple TV 专用]
# 当前复用同一 UMP 候选路径，仍必须以 Apple TV 真机验证前贴片、
# 中插、播放恢复、遥控器操作和长时间播放稳定性。
# ============================================================
[Script]
youtube.native.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.9/scripts/youtube-native-response.js?v=1.2.9,script-update-interval={{{update_interval}}},argument="{\"captionLang\":\"{{{caption_lang}}}\",\"blockUpload\":{{{block_upload}}},\"blockImmersive\":{{{block_immersive}}},\"blockShorts\":{{{block_shorts}}},\"debug\":{{{debug}}}}"
youtube.native.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*$,requires-body=1,max-size=-1,binary-body-mode=1,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.9/scripts/youtube-native-request.js?v=1.2.9,script-update-interval={{{update_interval}}}
youtube.native.response.init = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*$,requires-body=1,max-size=-1,binary-body-mode=1,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.9/scripts/youtube-native-ump.js?v=1.2.9,script-update-interval={{{update_interval}}},argument="{\"captionLang\":\"{{{caption_lang}}}\",\"blockUpload\":{{{block_upload}}},\"blockImmersive\":{{{block_immersive}}},\"blockShorts\":{{{block_shorts}}},\"debug\":{{{debug}}}}"
youtube.native.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.9/scripts/youtube-native-request.js?v=1.2.9,script-update-interval={{{update_interval}}}

# ============================================================
# [TVOS / Apple TV 专用]
# Apple TV 某些版本会把 player 返回为 JSON；此规则只处理该回退格式。
# 原生 UMP 规则仍负责可能出现的加密 initplayback 响应。
# ============================================================
youtube.tvos.json = type=http-response,pattern=^https:\/\/(?:(?:www|m)\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/player(?:\?.*)?$,requires-body=1,max-size=10485760,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.9/scripts/youtube-tvos-json.js?v=1.2.9,script-update-interval={{{update_interval}}}

# ============================================================
# [WEB / 移动浏览器专用]
# iPhone/iPad Safari 与其他 WebKit 浏览器复用基础模块的网页清理脚本。
# ============================================================
youtube.web.response = type=http-response,pattern=^https:\/\/(?:www|m)\.youtube\.com\/youtubei\/v1\/(?:next|browse|search|reel\/reel_watch_sequence|player\/ad_break)(?:\?.*)?$,requires-body=1,max-size=10485760,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.9/scripts/youtube-web-response.js?v=1.2.9,script-update-interval={{{update_interval}}}
youtube.web.page = type=http-response,pattern=^https:\/\/(?:www|m)\.youtube\.com\/(?:(?:watch|results|playlist)(?:\?.*)?|shorts\/(?:[^/?#]+)?(?:\?.*)?|(?:live|post|hashtag|clip|embed)\/[^/?#]+(?:\?.*)?|feed\/[^?#]+(?:\?.*)?|(?:@[^/?#]+|(?:channel|c|user)\/[^/?#]+)(?:\/[^?#]*)?(?:\?.*)?|(?:\?.*)?)$,requires-body=1,max-size=10485760,debug={{{debug}}},script-path=https://raw.githubusercontent.com/cndxf/lab/main/dist/youtube/releases/1.2.9/scripts/youtube-web-page.js?v=1.2.9,script-update-interval={{{update_interval}}}

# ============================================================
# [MITM]
# 解密 youtubei 、移动网页与原生 initplayback。证书和私钥不进入模块或仓库。
# ============================================================
[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, youtubei.googleapis.com, *.googlevideo.com
